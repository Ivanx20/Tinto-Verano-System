# =============================================================
# Plantilla de variables para Docker Compose.
# Copie este archivo como .env en la raiz del proyecto y cambie
# los valores. El archivo .env esta ignorado por Git a proposito:
# ningun secreto real debe subirse al repositorio.
#
#   Windows : copy .env.docker.example .env
#   Linux   : cp .env.docker.example .env
# =============================================================

# ---- PostgreSQL ----
POSTGRES_USER=tinto_user
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=tinto_verano_db

# ---- Puertos publicados en el equipo anfitrion ----
DB_HOST_PORT=5433
API_HOST_PORT=4100
WEB_HOST_PORT=5173

# ---- Secretos JWT (minimo 32 caracteres cada uno) ----
# Genere valores nuevos con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia_este_secreto_de_access_token_minimo_32_caracteres
JWT_REFRESH_SECRET=cambia_este_secreto_de_refresh_token_minimo_32_caracteres

# ---- Usuario administrador que crea el seed inicial ----
RUN_DB_SEED=true
SEED_ADMIN_EMAIL=admin@tintoverano.local
SEED_ADMIN_PASSWORD=Admin#2026.Tinto
SEED_ADMIN_NAME=Administrador Tinto Verano
