generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  CLEANING
  BILL_REQUESTED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  DEPOSIT
  MIXED
  CREDIT
  COURTESY
  INTERNAL_CONSUMPTION
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  PARTIAL
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  CREDIT
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  WASTE
}

model User {
  id                 Int            @id @default(autoincrement())
  name               String         @db.VarChar(150)
  email              String         @unique @db.VarChar(180)
  passwordHash       String         @db.VarChar(255)
  phone              String?        @db.VarChar(40)
  status             UserStatus     @default(ACTIVE)
  failedLoginCount   Int            @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  isActive           Boolean        @default(true)
  createdBy          Int?
  updatedBy          Int?
  userRoles          UserRole[]
  refreshTokens      RefreshToken[]
  sales              Sale[]         @relation("UserSales")
  auditLogs          AuditLog[]

  @@index([email])
  @@map("users")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique @db.VarChar(80)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isActive        Boolean          @default(true)
  createdBy       Int?
  updatedBy       Int?
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique @db.VarChar(120)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  isActive        Boolean          @default(true)
  createdBy       Int?
  updatedBy       Int?
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id           Int       @id @default(autoincrement())
  tokenHash    String    @db.VarChar(255)
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById Int?
  ipAddress    String?   @db.VarChar(80)
  userAgent    String?   @db.VarChar(255)
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Customer {
  id                 Int       @id @default(autoincrement())
  identificationType String    @default("CEDULA") @db.VarChar(30)
  identification     String?   @db.VarChar(40)
  name               String    @db.VarChar(180)
  email              String?   @db.VarChar(180)
  phone              String?   @db.VarChar(40)
  address            String?   @db.VarChar(255)
  birthday           DateTime?
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  isActive           Boolean   @default(true)
  createdBy          Int?
  updatedBy          Int?
  sales              Sale[]
  reservations       Reservation[]

  @@index([name])
  @@index([identification])
  @@map("customers")
}

model Supplier {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(180)
  ruc            String?   @db.VarChar(40)
  email          String?   @db.VarChar(180)
  phone          String?   @db.VarChar(40)
  address        String?   @db.VarChar(255)
  contactPerson  String?   @db.VarChar(150)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  isActive       Boolean   @default(true)
  createdBy      Int?
  updatedBy      Int?
  purchases      Purchase[]

  @@index([name])
  @@map("suppliers")
}

model ProductCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(120)
  description String?   @db.VarChar(255)
  color       String?   @db.VarChar(30)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  createdBy   Int?
  updatedBy   Int?
  products    Product[]

  @@map("product_categories")
}

model Product {
  id             Int              @id @default(autoincrement())
  categoryId     Int?
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  name           String           @db.VarChar(180)
  description    String?          @db.Text
  sku            String?          @unique @db.VarChar(80)
  price          Decimal          @db.Decimal(12, 2)
  cost           Decimal          @default(0) @db.Decimal(12, 2)
  taxRate        Decimal          @default(15.00) @db.Decimal(5, 2)
  imageUrl       String?          @db.VarChar(255)
  productType    String           @default("PLATO") @db.VarChar(40)
  isAvailable    Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  isActive       Boolean          @default(true)
  createdBy      Int?
  updatedBy      Int?
  variants       ProductVariant[]
  recipeItems    Recipe[]
  saleDetails    SaleDetail[]
  orderItems     OrderItem[]

  @@index([name])
  @@map("products")
}

model ProductVariant {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(120)
  extraPrice  Decimal   @default(0) @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  createdBy   Int?
  updatedBy   Int?

  @@map("product_variants")
}

model Ingredient {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(150)
  unit        String    @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  createdBy   Int?
  updatedBy   Int?
  recipes     Recipe[]
  inventoryItems InventoryItem[]

  @@map("ingredients")
}

model Recipe {
  id           Int        @id @default(autoincrement())
  productId    Int
  ingredientId Int
  quantity     Decimal    @db.Decimal(12, 3)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  isActive     Boolean    @default(true)
  createdBy    Int?
  updatedBy    Int?

  @@unique([productId, ingredientId])
  @@map("recipes")
}

model Warehouse {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(120)
  location    String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  createdBy   Int?
  updatedBy   Int?
  inventoryItems InventoryItem[]
  movements   InventoryMovement[]

  @@map("warehouses")
}

model InventoryItem {
  id              Int        @id @default(autoincrement())
  ingredientId    Int?
  ingredient      Ingredient? @relation(fields: [ingredientId], references: [id])
  warehouseId     Int
  warehouse       Warehouse  @relation(fields: [warehouseId], references: [id])
  name            String     @db.VarChar(180)
  unit            String     @db.VarChar(20)
  currentStock    Decimal    @default(0) @db.Decimal(12, 3)
  minimumStock    Decimal    @default(0) @db.Decimal(12, 3)
  averageCost     Decimal    @default(0) @db.Decimal(12, 2)
  expirationDate  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  isActive        Boolean    @default(true)
  createdBy       Int?
  updatedBy       Int?
  movements       InventoryMovement[]
  purchaseDetails PurchaseDetail[]

  @@index([name])
  @@map("inventory_items")
}

model InventoryMovement {
  id              Int          @id @default(autoincrement())
  inventoryItemId Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  warehouseId      Int
  warehouse        Warehouse    @relation(fields: [warehouseId], references: [id])
  type             MovementType
  quantity         Decimal      @db.Decimal(12, 3)
  unitCost         Decimal      @default(0) @db.Decimal(12, 2)
  reason           String?      @db.VarChar(255)
  reference        String?      @db.VarChar(120)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?
  isActive         Boolean      @default(true)
  createdBy        Int?
  updatedBy        Int?

  @@index([inventoryItemId])
  @@map("inventory_movements")
}

model Purchase {
  id           Int       @id @default(autoincrement())
  supplierId   Int
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  invoiceNumber String?  @db.VarChar(80)
  purchaseDate DateTime  @default(now())
  subtotal     Decimal   @default(0) @db.Decimal(12, 2)
  tax          Decimal   @default(0) @db.Decimal(12, 2)
  total        Decimal   @default(0) @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  isActive     Boolean   @default(true)
  createdBy    Int?
  updatedBy    Int?
  details      PurchaseDetail[]
  accountsPayable AccountsPayable[]

  @@map("purchases")
}

model PurchaseDetail {
  id              Int       @id @default(autoincrement())
  purchaseId      Int
  inventoryItemId Int
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Decimal   @db.Decimal(12, 3)
  unitCost        Decimal   @db.Decimal(12, 2)
  subtotal        Decimal   @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  isActive        Boolean   @default(true)
  createdBy       Int?
  updatedBy       Int?

  @@map("purchase_details")
}

model RestaurantTable {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(80)
  capacity    Int         @default(4)
  location    String?     @db.VarChar(120)
  status      TableStatus @default(FREE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  isActive    Boolean     @default(true)
  createdBy   Int?
  updatedBy   Int?
  orders      Order[]
  reservations Reservation[]

  @@map("restaurant_tables")
}

model Order {
  id        Int       @id @default(autoincrement())
  tableId   Int?
  table     RestaurantTable? @relation(fields: [tableId], references: [id])
  waiterId  Int?
  status    OrderStatus @default(PENDING)
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  createdBy Int?
  updatedBy Int?
  items     OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int       @id @default(autoincrement())
  orderId   Int
  productId Int
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  quantity  Decimal   @db.Decimal(12, 2)
  notes     String?   @db.VarChar(255)
  status    OrderStatus @default(PENDING)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  createdBy Int?
  updatedBy Int?

  @@map("order_items")
}

model Sale {
  id          Int       @id @default(autoincrement())
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id])
  cashierId   Int?
  cashier     User?     @relation("UserSales", fields: [cashierId], references: [id])
  saleNumber  String    @unique @db.VarChar(80)
  saleType    String    @default("DINE_IN") @db.VarChar(40)
  status      SaleStatus @default(COMPLETED)
  subtotal    Decimal   @default(0) @db.Decimal(12, 2)
  discount    Decimal   @default(0) @db.Decimal(12, 2)
  serviceFee  Decimal   @default(0) @db.Decimal(12, 2)
  tax         Decimal   @default(0) @db.Decimal(12, 2)
  total       Decimal   @default(0) @db.Decimal(12, 2)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  createdBy   Int?
  updatedBy   Int?
  details     SaleDetail[]
  payments    Payment[]
  invoices    Invoice[]
  accountsReceivable AccountsReceivable[]

  @@index([saleNumber])
  @@map("sales")
}

model SaleDetail {
  id        Int       @id @default(autoincrement())
  saleId    Int
  productId Int
  sale      Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
  quantity  Decimal   @db.Decimal(12, 2)
  unitPrice Decimal   @db.Decimal(12, 2)
  discount  Decimal   @default(0) @db.Decimal(12, 2)
  subtotal  Decimal   @db.Decimal(12, 2)
  notes     String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  createdBy Int?
  updatedBy Int?

  @@map("sale_details")
}

model Payment {
  id          Int       @id @default(autoincrement())
  saleId      Int
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method      PaymentMethod
  status      PaymentStatus @default(CONFIRMED)
  amount      Decimal   @db.Decimal(12, 2)
  reference   String?   @db.VarChar(120)
  bank        String?   @db.VarChar(120)
  receiptUrl  String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  createdBy   Int?
  updatedBy   Int?

  @@map("payments")
}

model CashRegister {
  id             Int       @id @default(autoincrement())
  openedBy       Int
  closedBy       Int?
  openingAmount  Decimal   @db.Decimal(12, 2)
  closingAmount  Decimal?  @db.Decimal(12, 2)
  expectedAmount Decimal?  @db.Decimal(12, 2)
  difference     Decimal?  @db.Decimal(12, 2)
  status         String    @default("OPEN") @db.VarChar(30)
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  isActive       Boolean   @default(true)
  createdBy      Int?
  updatedBy      Int?
  movements      CashMovement[]

  @@map("cash_registers")
}

model CashMovement {
  id             Int       @id @default(autoincrement())
  cashRegisterId Int
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  type           String    @db.VarChar(30)
  amount         Decimal   @db.Decimal(12, 2)
  reason         String?   @db.VarChar(255)
  reference      String?   @db.VarChar(120)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  isActive       Boolean   @default(true)
  createdBy      Int?
  updatedBy      Int?

  @@map("cash_movements")
}

model AccountsReceivable {
  id          Int       @id @default(autoincrement())
  saleId      Int
  sale        Sale      @relation(fields: [saleId], references: [id])
  amount      Decimal   @db.Decimal(12, 2)
  paidAmount  Decimal   @default(0) @db.Decimal(12, 2)
  dueDate     DateTime
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  createdBy   Int?
  updatedBy   Int?
  payments    AccountsReceivablePayment[]

  @@map("accounts_receivable")
}

model AccountsReceivablePayment {
  id                   Int       @id @default(autoincrement())
  accountsReceivableId  Int
  account               AccountsReceivable @relation(fields: [accountsReceivableId], references: [id], onDelete: Cascade)
  amount                Decimal   @db.Decimal(12, 2)
  method                PaymentMethod
  reference             String?   @db.VarChar(120)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  isActive              Boolean   @default(true)
  createdBy             Int?
  updatedBy             Int?

  @@map("accounts_receivable_payments")
}

model AccountsPayable {
  id          Int       @id @default(autoincrement())
  purchaseId  Int
  purchase    Purchase  @relation(fields: [purchaseId], references: [id])
  amount      Decimal   @db.Decimal(12, 2)
  paidAmount  Decimal   @default(0) @db.Decimal(12, 2)
  dueDate     DateTime
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  createdBy   Int?
  updatedBy   Int?
  payments    AccountsPayablePayment[]

  @@map("accounts_payable")
}

model AccountsPayablePayment {
  id                Int       @id @default(autoincrement())
  accountsPayableId Int
  account           AccountsPayable @relation(fields: [accountsPayableId], references: [id], onDelete: Cascade)
  amount            Decimal   @db.Decimal(12, 2)
  method            PaymentMethod
  reference         String?   @db.VarChar(120)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  isActive          Boolean   @default(true)
  createdBy         Int?
  updatedBy         Int?

  @@map("accounts_payable_payments")
}

model Reservation {
  id          Int       @id @default(autoincrement())
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id])
  tableId     Int?
  table       RestaurantTable? @relation(fields: [tableId], references: [id])
  customerName String   @db.VarChar(180)
  phone       String?   @db.VarChar(40)
  peopleCount Int
  reservationAt DateTime
  occasion    String?   @db.VarChar(120)
  notes       String?   @db.Text
  status      String    @default("PENDING") @db.VarChar(30)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  createdBy   Int?
  updatedBy   Int?

  @@map("reservations")
}

model Promotion {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(150)
  description String?   @db.Text
  type        String    @db.VarChar(40)
  value       Decimal   @db.Decimal(12, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  isActiveNow Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  createdBy   Int?
  updatedBy   Int?

  @@map("promotions")
}

model Invoice {
  id            Int       @id @default(autoincrement())
  saleId         Int
  sale           Sale      @relation(fields: [saleId], references: [id])
  invoiceNumber  String    @unique @db.VarChar(80)
  invoiceType    String    @db.VarChar(40)
  accessKey      String?   @db.VarChar(80)
  sriStatus      String    @default("GENERATED") @db.VarChar(40)
  pdfUrl         String?   @db.VarChar(255)
  xmlUrl         String?   @db.VarChar(255)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  isActive       Boolean   @default(true)
  createdBy      Int?
  updatedBy      Int?

  @@map("invoices")
}

model CompanySettings {
  id             Int       @id @default(autoincrement())
  businessName   String    @db.VarChar(180)
  ruc            String?   @db.VarChar(20)
  address        String?   @db.VarChar(255)
  phone          String?   @db.VarChar(40)
  email          String?   @db.VarChar(180)
  logoUrl        String?   @db.VarChar(255)
  taxRate        Decimal   @default(15.00) @db.Decimal(5, 2)
  serviceFeeRate Decimal   @default(10.00) @db.Decimal(5, 2)
  sriEnvironment String    @default("TEST") @db.VarChar(30)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  isActive       Boolean   @default(true)
  createdBy      Int?
  updatedBy      Int?

  @@map("company_settings")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   @db.VarChar(120)
  entity      String?  @db.VarChar(120)
  entityId    String?  @db.VarChar(80)
  ipAddress   String?  @db.VarChar(80)
  userAgent   String?  @db.VarChar(255)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@map("audit_logs")
}
