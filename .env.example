# =========================
# API
# =========================
NODE_ENV=development
PORT=4100
API_URL=http://localhost:4100
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=localhost
TRUST_PROXY=false

# PostgreSQL: crear primero la base tinto_verano_db
DATABASE_URL="postgresql://tinto_user:tinto_password@localhost:5432/tinto_verano_db?schema=public"

# JWT - cambia estos secretos en producción, mínimo 64 caracteres aleatorios
JWT_ACCESS_SECRET="CAMBIAR_por_un_secreto_largo_para_access_token_minimo_64_chars"
JWT_REFRESH_SECRET="CAMBIAR_por_un_secreto_largo_para_refresh_token_minimo_64_chars"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Seguridad
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=250
LOGIN_RATE_LIMIT_MAX=8

# Usuario seed inicial
SEED_ADMIN_EMAIL=admin@tintoverano.local
SEED_ADMIN_PASSWORD=CAMBIA_esta_password_de_admin
SEED_ADMIN_NAME=Administrador Tinto Verano
